# Copy to .env for local development. Never commit real credentials.
DRIFTLESS_ENVIRONMENT=local
DRIFTLESS_LOG_LEVEL=INFO
DRIFTLESS_LOG_JSON=false
DRIFTLESS_TEMPORAL_ADDRESS=localhost:7233
# Metadata DB (omit for an in-memory store in local dev)
DRIFTLESS_DATABASE_URL=postgresql://driftless:driftless@localhost:5432/driftless
# Secret backends: env: for dev; set Vault for real deployments
DRIFTLESS_SECRET_ENV_ENABLED=true
# DRIFTLESS_VAULT_ADDR=https://vault.internal:8200
# DRIFTLESS_VAULT_TOKEN=...
VITE_API_BASE_URL=/api/v1
