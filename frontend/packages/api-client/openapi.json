{
  "components": {
    "schemas": {
      "Capabilities": {
        "description": "What a connector supports \u2014 drives what the UI offers for an engine pair.",
        "properties": {
          "cdc": {
            "default": false,
            "title": "Cdc",
            "type": "boolean"
          },
          "native_checksum": {
            "default": false,
            "title": "Native Checksum",
            "type": "boolean"
          },
          "parallel_read": {
            "default": true,
            "title": "Parallel Read",
            "type": "boolean"
          },
          "read": {
            "default": true,
            "title": "Read",
            "type": "boolean"
          },
          "write": {
            "default": false,
            "title": "Write",
            "type": "boolean"
          }
        },
        "title": "Capabilities",
        "type": "object"
      },
      "CatalogSummary": {
        "properties": {
          "engine": {
            "title": "Engine",
            "type": "string"
          },
          "schemas": {
            "items": {
              "type": "string"
            },
            "title": "Schemas",
            "type": "array"
          },
          "server_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Server Version"
          },
          "tables": {
            "items": {
              "$ref": "#/components/schemas/TableSummary"
            },
            "title": "Tables",
            "type": "array"
          },
          "total_bytes": {
            "title": "Total Bytes",
            "type": "integer"
          },
          "total_rows": {
            "title": "Total Rows",
            "type": "integer"
          },
          "total_tables": {
            "title": "Total Tables",
            "type": "integer"
          }
        },
        "required": [
          "engine",
          "server_version",
          "schemas",
          "total_tables",
          "total_rows",
          "total_bytes",
          "tables"
        ],
        "title": "CatalogSummary",
        "type": "object"
      },
      "CheckStatus": {
        "enum": [
          "ok",
          "warning",
          "failed"
        ],
        "title": "CheckStatus",
        "type": "string"
      },
      "Connection": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "database": {
            "title": "Database",
            "type": "string"
          },
          "engine": {
            "title": "Engine",
            "type": "string"
          },
          "host": {
            "title": "Host",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "port": {
            "title": "Port",
            "type": "integer"
          },
          "secret_ref": {
            "title": "Secret Ref",
            "type": "string"
          },
          "ssl_mode": {
            "$ref": "#/components/schemas/SslMode"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "engine",
          "host",
          "port",
          "database",
          "username",
          "secret_ref",
          "ssl_mode",
          "created_at",
          "updated_at"
        ],
        "title": "Connection",
        "type": "object"
      },
      "ConnectionCheck": {
        "description": "One line of the pre-flight checklist shown on the Connect screen.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "fix_script": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fix Script"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "title": "ConnectionCheck",
        "type": "object"
      },
      "ConnectionCreate": {
        "properties": {
          "database": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Database",
            "type": "string"
          },
          "engine": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Engine",
            "type": "string"
          },
          "host": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Host",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^\\S(.*\\S)?$",
            "title": "Name",
            "type": "string"
          },
          "port": {
            "exclusiveMaximum": 65536.0,
            "exclusiveMinimum": 0.0,
            "title": "Port",
            "type": "integer"
          },
          "secret_ref": {
            "description": "Reference to the credential in a secrets backend, e.g. vault:db/billing-ro",
            "maxLength": 512,
            "pattern": "^[a-z][a-z0-9+-]*:\\S.*$",
            "title": "Secret Ref",
            "type": "string"
          },
          "ssl_mode": {
            "$ref": "#/components/schemas/SslMode",
            "default": "prefer"
          },
          "username": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "engine",
          "host",
          "port",
          "database",
          "username",
          "secret_ref",
          "name"
        ],
        "title": "ConnectionCreate",
        "type": "object"
      },
      "ConnectionSpec": {
        "description": "How to reach a database. Used to test a connection before saving it.",
        "properties": {
          "database": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Database",
            "type": "string"
          },
          "engine": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Engine",
            "type": "string"
          },
          "host": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Host",
            "type": "string"
          },
          "port": {
            "exclusiveMaximum": 65536.0,
            "exclusiveMinimum": 0.0,
            "title": "Port",
            "type": "integer"
          },
          "secret_ref": {
            "description": "Reference to the credential in a secrets backend, e.g. vault:db/billing-ro",
            "maxLength": 512,
            "pattern": "^[a-z][a-z0-9+-]*:\\S.*$",
            "title": "Secret Ref",
            "type": "string"
          },
          "ssl_mode": {
            "$ref": "#/components/schemas/SslMode",
            "default": "prefer"
          },
          "username": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "engine",
          "host",
          "port",
          "database",
          "username",
          "secret_ref"
        ],
        "title": "ConnectionSpec",
        "type": "object"
      },
      "ConnectionTestResult": {
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ConnectionCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "ok": {
            "description": "True when no check failed (warnings are allowed)",
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "checks"
        ],
        "title": "ConnectionTestResult",
        "type": "object"
      },
      "ConnectorInfo": {
        "properties": {
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          },
          "default_port": {
            "title": "Default Port",
            "type": "integer"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "engine": {
            "title": "Engine",
            "type": "string"
          }
        },
        "required": [
          "engine",
          "display_name",
          "default_port",
          "capabilities"
        ],
        "title": "ConnectorInfo",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "Page_Connection_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Connection"
            },
            "title": "Items",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "title": "Page[Connection]",
        "type": "object"
      },
      "SslMode": {
        "enum": [
          "disable",
          "prefer",
          "require",
          "verify-full"
        ],
        "title": "SslMode",
        "type": "string"
      },
      "TableSummary": {
        "properties": {
          "columns": {
            "title": "Columns",
            "type": "integer"
          },
          "has_primary_key": {
            "title": "Has Primary Key",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "rows": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rows"
          },
          "size_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Bytes"
          }
        },
        "required": [
          "name",
          "columns",
          "rows",
          "size_bytes",
          "has_primary_key"
        ],
        "title": "TableSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Driftless API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/connections": {
      "get": {
        "operationId": "list_connections_api_v1_connections_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_Connection_"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List connections",
        "tags": [
          "connections"
        ]
      },
      "post": {
        "operationId": "create_connection_api_v1_connections_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectionCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register a connection",
        "tags": [
          "connections"
        ]
      }
    },
    "/api/v1/connections/test": {
      "post": {
        "operationId": "test_connection_spec_api_v1_connections_test_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectionSpec"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionTestResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Test connection settings before saving",
        "tags": [
          "connections"
        ]
      }
    },
    "/api/v1/connections/{connection_id}": {
      "delete": {
        "operationId": "delete_connection_api_v1_connections__connection_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "connection_id",
            "required": true,
            "schema": {
              "title": "Connection Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete a connection",
        "tags": [
          "connections"
        ]
      },
      "get": {
        "operationId": "get_connection_api_v1_connections__connection_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "connection_id",
            "required": true,
            "schema": {
              "title": "Connection Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get a connection",
        "tags": [
          "connections"
        ]
      }
    },
    "/api/v1/connections/{connection_id}/discover": {
      "post": {
        "operationId": "discover_connection_api_v1_connections__connection_id__discover_post",
        "parameters": [
          {
            "in": "path",
            "name": "connection_id",
            "required": true,
            "schema": {
              "title": "Connection Id",
              "type": "string"
            }
          },
          {
            "description": "Limit to these schemas",
            "in": "query",
            "name": "schemas",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Limit to these schemas",
              "title": "Schemas"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read the database catalog (tables, sizes, keys)",
        "tags": [
          "connections"
        ]
      }
    },
    "/api/v1/connections/{connection_id}/test": {
      "post": {
        "operationId": "test_connection_api_v1_connections__connection_id__test_post",
        "parameters": [
          {
            "in": "path",
            "name": "connection_id",
            "required": true,
            "schema": {
              "title": "Connection Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionTestResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run pre-flight checks for a saved connection",
        "tags": [
          "connections"
        ]
      }
    },
    "/api/v1/connectors": {
      "get": {
        "operationId": "list_connectors_api_v1_connectors_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConnectorInfo"
                  },
                  "title": "Response List Connectors Api V1 Connectors Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List supported engines",
        "tags": [
          "connectors"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    }
  }
}
